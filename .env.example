# Copy this file to ".env" and fill in your keys
GEMINI_API_KEY=your_gemini_api_key_here
HF_API_KEY=your_huggingface_token_here

# Gemini models (change if Google retires a model name)
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash

# Backup models, tried in order if the main one is busy or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Stable Diffusion
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SD_STEPS=25

# Set to true to skip Stable Diffusion and draw placeholder panels (fast UI/PDF testing)
USE_PLACEHOLDER_IMAGES=false
